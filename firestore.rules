rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Basic helpers
    function isAdmin() {
      return request.auth != null &&
             request.auth.token.email == "odiljonsirojiddinov04@gmail.com";
    }

    // Allow public read for all collections
    match /{collection}/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Explicit matches for safety and clarity
    match /projects/{projectId} { allow read: if true; }
    match /achievements/{id} { allow read: if true; }
    match /publications/{id} { allow read: if true; }
    match /experiences/{id} { allow read: if true; }
    match /skills/{id} { allow read: if true; }
    match /profile/{id} { allow read: if true; }
    match /messages/{id} { allow create: if true; allow read, update, delete: if isAdmin(); }
  }
}
