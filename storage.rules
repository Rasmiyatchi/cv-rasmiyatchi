rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Profile images: public read, admin-only write
    match /profile/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.email == 'odiljonsirojiddinov04@gmail.com';
    }
  }
}
