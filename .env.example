# ─────────────────────────────────────────────────────────────
# Firebase konfiguratsiyasi
# Yangi Firebase loyihasini ulash uchun bu faylni `.env.local` deb
# nusxalang va Firebase Console > Project settings > "Your apps" (Web)
# bo'limidagi qiymatlar bilan to'ldiring.
# ─────────────────────────────────────────────────────────────
VITE_FIREBASE_API_KEY="YOUR_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="1234567890"
VITE_FIREBASE_APP_ID="1:1234567890:web:abcdef123456"

# Ixtiyoriy: Google Analytics measurement ID
VITE_FIREBASE_MEASUREMENT_ID=""

# Ixtiyoriy: maxsus Firestore bazasi ID si. Bo'sh qoldirilsa "(default)" ishlatiladi.
VITE_FIREBASE_FIRESTORE_DB_ID=""
